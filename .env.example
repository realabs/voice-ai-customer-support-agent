# Set these as environment variables of your n8n instance (not in Vapi)
BACKEND_API_URL=https://api.example.com
BACKEND_API_TOKEN=replace-me
ZENDESK_URL=https://yourcompany.zendesk.com
# Zendesk credential: create an "HTTP Basic Auth" credential in n8n
# user: agent@yourcompany.com/token   password: <Zendesk API token>
