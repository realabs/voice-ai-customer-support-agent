{
  "name": "Voice agent - Vapi tool calls (template)",
  "nodes": [
    {
      "parameters": {
        "content": "## Vapi tool-calls webhook (template)\nOne endpoint for all tools of the voice agent.\n\n1. Set env vars: BACKEND_API_URL, BACKEND_API_TOKEN, ZENDESK_URL\n2. Attach an HTTP Basic Auth credential to **Zendesk: create ticket**\n3. Point every Vapi tool's server URL to this webhook\n\nAccount lookup uses the caller's number first (call.customer.number) and only falls back to a dictated number.\nOne tool call per request is handled (Vapi's normal behaviour).",
        "height": 300,
        "width": 420
      },
      "id": "a20fe818-d0ad-4109-bde1-98ad70faaa86",
      "name": "Sticky Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -80,
        -420
      ]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "vapi-tools",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "c7826703-b30f-43cc-9cf9-d82e08f2c066",
      "name": "Vapi webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "86ea760d-1579-4b53-85dc-8761f5c6bda4"
    },
    {
      "parameters": {
        "jsCode": "// Vapi sends: { message: { type: 'tool-calls', toolCallList: [...], call: { customer: { number } } } }\n// Arguments arrive as an object (sometimes as a JSON string): handle both.\nconst body = $input.first().json.body || $input.first().json;\nconst msg = body.message || {};\nconst callerNumber = (msg.call && msg.call.customer && msg.call.customer.number) || (msg.customer && msg.customer.number) || '';\nconst calls = msg.toolCallList || msg.toolCalls || [];\nconst out = [];\nfor (const tc of calls) {\n  const fn = tc.function || {};\n  let args = fn.arguments || {};\n  if (typeof args === 'string') {\n    try { args = JSON.parse(args); } catch (e) { args = {}; }\n  }\n  // Caller ID first; a dictated number only when the agent passes one explicitly\n  let phone = String(args.phone_number || callerNumber || '').replace(/[^0-9+]/g, '');\n  if (phone && phone[0] !== '+') { phone = '+' + phone; }\n  out.push({ json: { toolCallId: tc.id, name: fn.name, args: args, phone: phone, callerNumber: callerNumber } });\n}\nreturn out;"
      },
      "id": "398b59fd-1aae-4aab-bde9-517a2a74775c",
      "name": "Parse tool calls",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
