    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.ZENDESK_URL }}/api/v2/tickets.json",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBasicAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ ticket: {\n  subject: 'Voice call: ' + String($json.args.summary || '').slice(0, 80),\n  comment: { body: ($json.args.summary || '') + '\\n\\nCaller number: ' + ($json.callerNumber || 'unknown') + '\\nContact number: ' + ($json.args.phone_number || $json.callerNumber || 'unknown') + '\\nAccount: ' + ($json.args.account_id || 'not identified') + '\\nLanguage: ' + ($json.args.language || 'es') + '\\nSource: voice agent', public: false },\n  priority: $json.args.priority === 'high' ? 'urgent' : 'normal',\n  tags: ['voice_agent', 'lang_' + ($json.args.language || 'es')],\n  requester: { name: 'Phone caller ' + ($json.args.phone_number || $json.callerNumber || '') }\n} }) }}",
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        }
      },
      "id": "661c7b80-ff00-437f-859e-b8bc56c6bc87",
      "name": "Zendesk: create ticket",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        700,
        320
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const req = $('Parse tool calls').item.json;\nreturn { json: { toolCallId: req.toolCallId, result: JSON.stringify({ status: 'error', message: 'Unknown tool ' + req.name }) } };"
      },
      "id": "83473a40-c330-4dec-8d2b-51a37535ba46",
      "name": "Unknown tool",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        700,
        520
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const r = $json;\nconst req = $('Parse tool calls').item.json;\nconst a = r.body || {};\nlet result;\nif (r.statusCode === 200 && a.account_id) {\n  result = { status: 'found', account_id: a.account_id, first_name: a.first_name || '', used_caller_id: !req.args.phone_number };\n} else {\n  result = { status: 'not_found', used_caller_id: !req.args.phone_number,\n    next_step: req.args.phone_number ? 'Offer to create a ticket for a human.' : 'Ask the caller for the phone number registered in the app, with country code.' };\n}\nreturn { json: { toolCallId: req.toolCallId, result: JSON.stringify(result) } };"
      },
      "id": "42aa8762-9b98-43de-a6e3-0a51516b0fcc",
      "name": "Format: lookup_account",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        940,
        -480
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const r = $json;\nconst req = $('Parse tool calls').item.json;\nconst ride = r.body || {};\nlet result;\nif (r.statusCode === 200 && ride.ride_id) {\n  result = { status: 'active', ride_id: ride.ride_id, started_minutes_ago: ride.started_minutes_ago };\n} else if (r.statusCode === 404 || r.statusCode === 200) {\n  result = { status: 'no_active_ride' };\n} else {\n  result = { status: 'error', next_step: 'Apologize and offer to create a ticket.' };\n}\nreturn { json: { toolCallId: req.toolCallId, result: JSON.stringify(result) } };"
      },
      "id": "badd99de-f210-4a16-959e-f4a1fbd6eba4",
      "name": "Format: check_active_ride",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        940,
        -280
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const r = $json;\nconst req = $('Parse tool calls').item.json;\nconst ok = r.statusCode >= 200 && r.statusCode < 300;\nconst result = ok\n  ? { status: 'ended', ride_id: req.args.ride_id, note: 'Billing stopped.' }\n  : { status: 'failed', next_step: 'Create a ticket so a human ends the ride manually.' };\nreturn { json: { toolCallId: req.toolCallId, result: JSON.stringify(result) } };"
      },
      "id": "6b814a48-57d3-4aad-a264-07d2dc048abf",
      "name": "Format: end_ride",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        940,
        -80
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const r = $json;\nconst req = $('Parse tool calls').item.json;\n// Balances live in wallets[], one per country/currency. Keep only non-zero ones.\nconst wallets = (r.body && r.body.wallets) || [];\nconst items = [];\nfor (const w of wallets) {\n  if ((w.balance || 0) > 0 || (w.bonus || 0) > 0) {\n    items.push({ currency: w.currency, balance: w.balance || 0, bonus: w.bonus || 0 });\n  }\n}\nconst result = r.statusCode === 200\n  ? { status: 'ok', wallets: items }\n  : { status: 'error', next_step: 'Apologize and offer to create a ticket.' };\nreturn { json: { toolCallId: req.toolCallId, result: JSON.stringify(result) } };"
      },
      "id": "e6a7c2d2-13f9-401f-ade0-75022fd59c86",
      "name": "Format: check_balance",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        940,
        120
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const r = $json;\nconst req = $('Parse tool calls').item.json;\nconst t = (r.body && r.body.ticket) || {};\nconst result = (r.statusCode === 201 || r.statusCode === 200) && t.id\n  ? { status: 'created', ticket_id: t.id, promise: 'An agent will contact the customer on WhatsApp within 30 minutes.' }\n  : { status: 'failed', next_step: 'Apologize and ask the customer to write on WhatsApp.' };\nreturn { json: { toolCallId: req.toolCallId, result: JSON.stringify(result) } };"
      },
      "id": "de9a5731-493e-4f12-b20d-9dd828e5a7fd",
      "name": "Format: create_ticket",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        940,
        320
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ results: [{ toolCallId: $json.toolCallId, result: $json.result }] }) }}",
        "options": {}
      },
      "id": "4228526a-80bb-41d0-8ca4-5a9de2861fa8",
      "name": "Respond to Vapi",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1200,
        0
      ]
    }
